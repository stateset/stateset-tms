# Local demo only. Disable both API and web demo mode for a real workspace.
FREIGHT_DEMO=true
FREIGHT_BIND_ADDR=127.0.0.1:8090
FREIGHT_API_URL=http://127.0.0.1:8090
FREIGHT_WEB_ORIGIN=http://127.0.0.1:3010
FREIGHT_API_KEYS_JSON='{}'
FREIGHT_INTEGRATIONS_JSON='{}'
# Concurrent tenant integration cycles per process, 1–16; each tenant stays serial.
FREIGHT_INTEGRATION_CONCURRENCY=2
# Process drain after SIGTERM/SIGINT, 1–300000 ms. Leave container stop time above it.
FREIGHT_SHUTDOWN_TIMEOUT_MS=30000
# Optional dedicated process-wide metrics credential (32–512 visible ASCII characters).
# Empty/unset disables /metrics. Keep separate from staff/partner API credentials.
# FREIGHT_METRICS_TOKEN=
# Required for real workspaces. Use an independent, disposable DB for tests.
# DATABASE_URL=postgres://freight:password@127.0.0.1:5432/freight
# Schema startup: apply (default) or verify (no schema DDL; requires all migrations).
# Install with the migration role: stateset-freight --migrate
# Use the same database and protected search_path for migration and runtime roles.
# Then set verify for a runtime role without schema CREATE or migration-history writes.
FREIGHT_MIGRATIONS=apply
# Per API process, 1–64. Size against aggregate payloads and database memory.
FREIGHT_DATABASE_MAX_CONNECTIONS=2
FREIGHT_WRITE_MAX_IN_FLIGHT=64
FREIGHT_WRITE_TENANT_MAX_IN_FLIGHT=16
# Per-process pool wait and PostgreSQL per-statement/per-lock budgets, in ms.
# All must be 1–300000. Migration limits remain separately 10s/60s.
FREIGHT_DATABASE_ACQUIRE_TIMEOUT_MS=5000
FREIGHT_DATABASE_STATEMENT_TIMEOUT_MS=30000
FREIGHT_DATABASE_LOCK_TIMEOUT_MS=5000
# Snapshot decode jobs, and complete staff workspace/control-tower read pipelines.
FREIGHT_READ_CONCURRENCY=2
FREIGHT_READ_MAX_PENDING=64
FREIGHT_READ_TENANT_MAX_PENDING=16
FREIGHT_READ_QUEUE_TIMEOUT_MS=5000
# Required by Docker Compose:
# POSTGRES_PASSWORD=replace-with-a-random-database-password
# Compose passes this literal value through PGPASSWORD, without URL encoding.
# For a direct DATABASE_URL, encode URL passwords or omit one and set PGPASSWORD.
# Generate a random secret of at least 32 characters for encrypted web sessions.
# FREIGHT_SESSION_SECRET=
# Optional explicit recovery keyring; otherwise a domain-separated session-secret key is used.
# Clerk deployments need this keyring or a valid FREIGHT_SESSION_SECRET.
# FREIGHT_SAVE_JOURNAL_KEYS_JSON={"active":"your-key-id","keys":{"your-key-id":"replace-with-base64url-of-32-random-bytes"}}
# FREIGHT_COOKIE_SECURE=true
# Staff sign-in uses the same Clerk instance/organizations as StateSet App.
# Read docs/sso.md before enabling; never put the secret JSON in browser variables.
# FREIGHT_WEB_AUTH_MODE=clerk
# FREIGHT_CLERK_PUBLISHABLE_KEY=pk_live_your_public_key
# FREIGHT_CLERK_JSON='{"issuer":"https://clerk.stateset.com","secret_key":"replace-with-your-Clerk-backend-secret","authorized_parties":["https://freight.your-domain.example"],"organizations":{"org_your_real_id":{"tenant_id":"your_existing_freight_tenant","roles":{"org:freight_operations":"operations","org:freight_finance":"finance","org:freight_viewer":"viewer"}}}}'
RUST_LOG=stateset_freight=info,tower_http=info

# /portal uses explicit carrier/customer roles plus server-owned counterparty_id.
# See docs/partner-portal.md; do not issue tenant-wide staff credentials to partners.

# Compose selects the separate PDF renderer automatically; see docs/terminal.md.
# Native Linux defaults to mandatory Landlock isolation. To use an isolated service:
# FREIGHT_PDF_RENDERER_SOCKET=/run/freight-pdf/renderer.sock
# FREIGHT_PDF_RENDERER_UID=10002
